{
   "author": "steled",
   "background": {
      "service_worker": "background.js"
   },
   "action": {
      "default_icon": "images/icon32.png",
      "default_popup": "popup.html",
      "default_title": "MyJDownloader"
   },
   "commands": {
      "auto-grab-downloads": {
         "description": "__MSG_toggle_auto_grab_links__",
         "suggested_key": {
            "default": "Ctrl+Shift+Y",
            "mac": "Command+Shift+Y"
         }
      },
      "toggle-clipboard-observer": {
         "description": "__MSG_toggle_clipboard_observer__",
         "suggested_key": {
            "default": "Ctrl+Shift+X",
            "mac": "Command+Shift+X"
         }
      }
   },
   "content_scripts": [
      {
         "all_frames": true,
         "js": [
            "contentscripts/cnlInterceptorMain.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start",
         "world": "MAIN"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/cnlContentscript.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/rc2Contentscript.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/rc2LoadingIndicator.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/onCopyContentscript.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/toolbarContentscript.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/selectionContentscript.js"
         ],
         "matches": [
            "<all_urls>"
         ],
         "run_at": "document_start"
      },
      {
         "all_frames": true,
         "js": [
            "contentscripts/webinterfaceEnhancer.js"
         ],
         "matches": [
            "http://my.jdownloader.org/*",
            "https://my.jdownloader.org/*"
         ],
         "run_at": "document_end"
      }
   ],
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "homepage_url": "https://github.com/steled/myjdownloader-mv3-unofficial",
   "icons": {
      "48": "images/icon48.png",
      "128": "images/icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_extensionName__",
   "options_ui": {
      "page": "index.html#!/settings"
   },
   "permissions": [
      "tabs",
      "storage",
      "contextMenus",
      "scripting",
      "declarativeNetRequest",
      "declarativeNetRequestFeedback"
   ],
   "host_permissions": [
      "<all_urls>"
   ],
   "short_name": "MyJDownloader",
   "update_url": "https://raw.githubusercontent.com/steled/myjdownloader-mv3-unofficial/main/updates.xml",
   "version": "3.3.22",
   "web_accessible_resources": [
      {
         "resources": [
            "toolbar.html",
            "autograbber-indicator.html",
            "res/browser_solver_template.html",
            "res/jdcheck.js"
         ],
         "matches": [
            "<all_urls>"
         ]
      }
   ]
}
