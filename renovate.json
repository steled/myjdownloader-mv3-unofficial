{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>steled/renovate-config"
  ],
  "enabledManagers": [
    "npm",
    "github-actions"
  ],
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "semanticCommitType": "build"
    },
    {
      "description": "Only propose Node.js versions from even-numbered (LTS) lines",
      "matchDatasources": [
        "node-version"
      ],
      "matchDepNames": [
        "node"
      ],
      "allowedVersions": "/^\\d*[02468]\\.\\d+\\.\\d+$/"
    }
  ]
}
